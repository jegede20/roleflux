# ── Supabase ──────────────────────────────────────────────
# Public (browser-safe) values from your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — SERVER ONLY. Never expose to the browser.
# Used by cron ingestion + bulk matching to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Groq ──────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key

# ── Cron security ─────────────────────────────────────────
# Any long random string. Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>`.
# Generate with:  openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-string

# ── App ───────────────────────────────────────────────────
# Used for magic-link / OAuth redirects. In prod set to your deployed URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
